# What every KOOMPI kernel is, whatever the target (DESIGN.md C4). Merged
# first over `make defconfig`; hardening, virt and the target's own fragment
# follow, and a later line overrides an earlier one by symbol. The linux
# recipe checks that every resulting line survives olddefconfig. Upstream's
# defaults are not restated: what is here is what we decided.

# spec.md: every module published before this would be invalidated later.
CONFIG_MODVERSIONS=y
# spec.md: no debug packages ship, and DEBUG_INFO is most of the build tree.
CONFIG_DEBUG_INFO_NONE=y

# Modules are signed with a key the build generates and discards.
# MODULE_SIG_FORCE turns on the day the real key exists (DESIGN.md C4).
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA256=y

# The root is erofs on dm-verity, opened by the kernel itself from its
# command line (DESIGN.md C2, C3); /etc is an overlay above it and the
# state partition is ext4 (C1).
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_INIT=y
CONFIG_DM_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Until C2 lands, the userland still arrives as an initramfs.
CONFIG_BLK_DEV_INITRD=y

# What a container runtime and a sandbox need: cgroup v2 with its
# controllers (the v2 device controller is BPF), every namespace, seccomp
# filters, Landlock, and the lockdown LSM.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y

# Booted through the ESP from M3 on.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y

CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
