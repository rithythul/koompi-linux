# Gate 0 target one, over core, hardening and virt.

# A cloud guest has no display: the serial port is the console.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# DESIGN.md C4 hardening, the x86 half: no vsyscall page, no 32-bit
# emulation, and KASLR for the direct map as well as the text.
# (X86_VSYSCALL_EMULATION itself is only visible under EXPERT; the mapping
# is what the legacy-vsyscall choice controls.)
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_IA32_EMULATION is not set
CONFIG_RANDOMIZE_MEMORY=y
