# Merged over `make ARCH=arm64 defconfig`, then resolved by olddefconfig.
# Only what this target needs beyond the kernel's own default; the defaults
# are not restated, so what is here is what we decided.

# spec.md: every module published before this would be invalidated later.
CONFIG_MODVERSIONS=y
# spec.md: no debug packages ship, and DEBUG_INFO is most of the build tree.
CONFIG_DEBUG_INFO_NONE=y

# The whole userland arrives as an initramfs.
CONFIG_BLK_DEV_INITRD=y

# Headless: the serial port is the console.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# What a virtio machine is made of.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SCSI_VIRTIO=y

# M3 boots this through the ESP rather than with -kernel.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_PCI_HOST_GENERIC=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
